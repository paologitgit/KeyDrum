# Kopieren nach .env und ausfuellen. Die Datei .env wird nie eingecheckt.

# Schluessel fuer die Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Postausgang fuer den Bewerbungsversand
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_BENUTZER=ihre.adresse@gmail.com
SMTP_PASSWORT=app-spezifisches-passwort
SMTP_ABSENDER=ihre.adresse@gmail.com

# Solange dieser Wert auf 1 steht, wird keine Mail wirklich verschickt.
# Sie sehen den fertigen Versand nur im Protokoll. Erst auf 0 setzen,
# wenn Sie mindestens eine Bewerbung Wort fuer Wort geprueft haben.
TROCKENLAUF=1
